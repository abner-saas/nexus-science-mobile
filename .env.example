# API local. No celular físico use o IP da máquina, não localhost.
# Emulador Android: http://10.0.2.2:3333
EXPO_PUBLIC_API_URL=http://localhost:3333

# Produção (não commitar um .env com isto se for ambiente pessoal; a URL é pública):
# EXPO_PUBLIC_API_URL=https://api-abner-saas.patitow.dev

# Opcional. Sem isto o app pede permissão de notificação, mas não consegue
# um Expo push token (getExpoPushTokenAsync exige o project id do EAS).
# EXPO_PUBLIC_EAS_PROJECT_ID=
